# Build the React site, then serve it with Caddy (which also gets the HTTPS certificate
# and forwards /api/* to the API container).
FROM node:22-slim AS build
WORKDIR /ui
# The committed package-lock.json was made on a Mac and lacks the Linux build tools npm needs,
# so install fresh here (otherwise "Cannot find native binding").
COPY frontend/sentinelwatch-ui/package.json ./
RUN npm install --no-audit --no-fund
COPY frontend/sentinelwatch-ui/ ./
ENV VITE_API_URL=/api
RUN npm run build

FROM caddy:2
COPY --from=build /ui/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
